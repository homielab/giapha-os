# -----------------------------------------------------------------------------
# GIA PHẢ OS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn
# 3. Không bọc giá trị trong dấu nháy, kể cả khi có khoảng trắng (Gia Phả OS):
#    "docker run --env-file" giữ nguyên dấu nháy trong giá trị

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME=Gia Phả OS

# Tên ngắn hiện dưới biểu tượng khi cài ứng dụng lên màn hình chính điện thoại
SHORT_NAME=Gia Phả

# URL của project Supabase (Lấy từ Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Khóa Public (Lấy từ Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-or-public-key

# Đặt true để ẩn nút đăng nhập Google/Facebook nếu chưa cấu hình SSO
NEXT_PUBLIC_DISABLE_SSO=true

# URL public (email duyệt tài khoản, link chia sẻ, sitemap). Chỉ lấy phần gốc:
# thiếu https:// sẽ tự thêm, đường dẫn phía sau bị bỏ
APP_URL=https://your-domain.vercel.app

# Server-only: Supabase Project Settings > API Keys > Secret keys > default
# Nếu project dùng giao diện cũ: Project Settings > API > Legacy API Keys > service_role
# Secret/service_role key có quyền cao, tuyệt đối không đổi tên thành NEXT_PUBLIC_*
# và không đưa key này lên client, source code hoặc Git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: PostgreSQL connection string dùng cho công cụ migration trong Dashboard.
# Lấy tại Supabase Dashboard > Project Settings > Database > Connection Pooling (Session mode).
# Không dùng anon/service-role key ở biến này và tuyệt đối không đưa lên client.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Resend (https://resend.com) dùng để gửi email thông báo cho admin
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Gia Phả OS <no-reply@your-verified-domain.com>

# Tuỳ chọn: email nhận thông báo. Nếu bỏ trống, hệ thống tự lấy email của các admin đang hoạt động.
# Có thể nhập nhiều email, ngăn cách bằng dấu phẩy.
ADMIN_NOTIFICATION_EMAIL=admin@example.com
